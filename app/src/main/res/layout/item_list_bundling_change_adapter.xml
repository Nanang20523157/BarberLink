<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minWidth="270dp"
        android:layout_marginHorizontal="4dp"
        app:cardCornerRadius="15dp"
        app:cardElevation="0.5dp"
        android:layout_gravity="center_horizontal"
        android:backgroundTint="@color/light_grey_horizons_background"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="3dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="17dp"
            android:paddingTop="13dp"
            android:paddingEnd="17dp"
            android:paddingBottom="13dp">

            <!-- Left Container: Number Badge + Text -->
            <LinearLayout
                android:id="@+id/top_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="horizontal">

                <!-- Number Badge Background -->
                <FrameLayout
                    android:id="@+id/badge_background"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="@drawable/circle_badge_background"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/badge_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:fontFamily="sans-serif-black"
                        android:text="01"
                        android:textColor="#0F172A"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </FrameLayout>

                <!-- Outlet Name -->
                <TextView
                    android:id="@+id/bundling_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="marquee"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#0F172A"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:layout_gravity="center_vertical"
                    tools:text="Package Supernova"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/minus_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/magenta"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_box_alpha_magenta"
                    android:layout_gravity="center_vertical"
                    tools:text="-20K"
                    android:layout_marginEnd="1dp"
                    android:paddingHorizontal="10dp"/>

            </LinearLayout>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="10dp"
                app:cardElevation="0.5dp"
                android:backgroundTint="@color/light_grey_horizons_background"
                android:layout_marginTop="4dp"
                android:layout_below="@id/top_container"
                android:layout_marginBottom="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvPriceBefore"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rp 300.000"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:layout_marginVertical="10dp"
                        android:textColor="@color/green_btn"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:textIsSelectable="true"
                        android:gravity="center"
                        android:textSize="14sp"
                        android:fontFamily="@font/arial_medium"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.AppCompat.Headline"/>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/cvArrowIncrease"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:strokeWidth="2dp"
                        app:strokeColor="@color/grey_300"
                        app:cardBackgroundColor="@color/light_grey_horizons_background"
                        app:cardCornerRadius="50dp"
                        android:layout_gravity="center_vertical"
                        app:cardElevation="5dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:padding="3dp"
                            app:tint="@color/orange_role"
                            android:src="@drawable/ic_arrow_of_change"/>

                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:id="@+id/tvPriceAfter"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rp 120.000"
                        android:singleLine="true"
                        android:ellipsize="marquee"
                        android:marqueeRepeatLimit="marquee_forever"
                        android:textIsSelectable="true"
                        android:gravity="center"
                        android:layout_marginVertical="10dp"
                        android:textSize="14sp"
                        android:textColor="@color/magenta"
                        android:fontFamily="@font/arial_medium"
                        android:textStyle="bold"
                        android:textAppearance="@style/TextAppearance.AppCompat.Headline"
                        android:layout_below="@id/cvPriceBefore"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </RelativeLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
