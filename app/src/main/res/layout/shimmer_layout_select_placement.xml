<?xml version="1.0" encoding="utf-8"?>
<com.facebook.shimmer.ShimmerFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:layout_marginHorizontal="2dp"
    app:shimmer_auto_start="true"
    app:shimmer_base_alpha="0.7"
    app:shimmer_direction="left_to_right"
    app:shimmer_duration="500"
    app:shimmer_repeat_count="@android:integer/config_shortAnimTime"
    app:shimmer_repeat_delay="500"
    app:shimmer_shape="linear"
    app:shimmer_tilt="0">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_item_rounded_unselected"
        android:padding="16dp">

        <!-- Outlet Image Placeholder -->
        <View
            android:id="@+id/ivOutletImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:background="@drawable/shimmer_corner_delapan_dp_300"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Outlet Name Placeholder -->
        <View
            android:id="@+id/tvOutletName"
            android:layout_width="0dp"
            android:layout_height="18dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/shimmer_corner_empat_dp_300"
            app:layout_constraintEnd_toStartOf="@+id/ivCheckSelector"
            app:layout_constraintStart_toEndOf="@+id/ivOutletImage"
            app:layout_constraintTop_toTopOf="@+id/ivOutletImage" />

        <!-- Outlet Address Placeholder -->
        <View
            android:id="@+id/tvOutletAddress"
            android:layout_width="0dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/shimmer_corner_tiga_dp_300"
            app:layout_constraintEnd_toEndOf="@+id/tvOutletName"
            app:layout_constraintStart_toStartOf="@+id/tvOutletName"
            app:layout_constraintTop_toBottomOf="@+id/tvOutletName" />

        <!-- Container untuk Badge Status dan Jarak Placeholder -->
        <LinearLayout
            android:id="@+id/llBadgeContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_inactive_distance"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginStart="-2dp"
            android:layout_marginBottom="3dp"
            android:paddingStart="15dp"
            android:paddingEnd="6dp"
            android:paddingVertical="4.5dp"
            app:layout_constraintStart_toStartOf="@+id/tvOutletName"
            app:layout_constraintEnd_toEndOf="@id/tvOutletName"
            app:layout_constraintBottom_toBottomOf="@id/ivOutletImage">

            <!-- Titik indikator kecil -->
            <View
                android:id="@+id/vBadgeDot"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/ic_dot_inactive_distance" />

            <TextView
                android:id="@+id/tvEmployeeCount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="5 Pegawai"
                android:textStyle="bold"
                android:textColor="@color/grey_300"
                android:textSize="11.5sp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/shimmer_corner_tiga_dp_300" />

            <TextView
                android:layout_width="45dp"
                android:layout_height="wrap_content"
                android:background="@drawable/shimmer_corner_delapan_dp_300"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="1.5dp"
                android:text="Aktif"
                android:textColor="@color/grey_300"
                android:textSize="10sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_gravity="center_vertical" />
        </LinearLayout>

        <!-- Selector Icon Placeholder -->
        <View
            android:id="@+id/ivCheckSelector"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/shimmer_circle_shape"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.facebook.shimmer.ShimmerFrameLayout>
