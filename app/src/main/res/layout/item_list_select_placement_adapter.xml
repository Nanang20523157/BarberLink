<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:clipToPadding="false"
    android:clipToOutline="false"
    android:layout_marginHorizontal="2dp"
    android:background="@drawable/bg_item_rounded_unselected"
    android:padding="16dp">

    <!-- Outlet Image (Gambar Barbershop) -->
    <!-- Catatan: Gunakan ShapeableImageView untuk mendapatkan sudut melengkung -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivOutletImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/RoundedCornerImageView"
        tools:src="@tools:sample/backgrounds/scenic" />

    <!-- Outlet Name (Nama Barbershop) -->
    <TextView
        android:id="@+id/tvOutletName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:ellipsize="marquee"
        android:marqueeRepeatLimit="marquee_forever"
        android:singleLine="true"
        android:textColor="#191C1D"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@+id/ivCheckSelector"
        app:layout_constraintStart_toEndOf="@+id/ivOutletImage"
        app:layout_constraintTop_toTopOf="@+id/ivOutletImage"
        tools:text="Barbershop 01 - Sudirman" />

    <!-- Outlet Address (Alamat) -->
    <TextView
        android:id="@+id/tvOutletAddress"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="marquee"
        android:singleLine="true"
        android:textColor="#0f172a"
        android:textSize="10sp"
        android:marqueeRepeatLimit="marquee_forever"
        app:layout_constraintEnd_toEndOf="@+id/tvOutletName"
        app:layout_constraintStart_toStartOf="@+id/tvOutletName"
        app:layout_constraintTop_toBottomOf="@+id/tvOutletName"
        tools:text="Jl. Jendral Sudirman No. 1" />

    <!-- Container untuk Badge Status dan Jarak -->
    <LinearLayout
        android:id="@+id/llBadgeContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_badge_inactive_distance"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginStart="-2dp"
        android:layout_marginBottom="3dp"
        android:paddingStart="15dp"
        android:paddingEnd="6dp"
        android:paddingVertical="4.5dp"
        android:clipToPadding="false"
        android:clipChildren="false"
        app:layout_constraintStart_toStartOf="@+id/tvOutletName"
        app:layout_constraintEnd_toEndOf="@id/tvOutletName"
        app:layout_constraintBottom_toBottomOf="@id/ivOutletImage">

        <!-- Titik indikator kecil -->
        <View
            android:id="@+id/vBadgeDot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/ic_dot_inactive_distance" />

        <TextView
            android:id="@+id/tvEmployeeCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textColor="#3C4949"
            android:textSize="11.5sp"
            android:layout_weight="1"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:letterSpacing="-0.03"
            tools:text="5 Pegawai" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/background_employee_counting"
            android:fontFamily="@font/arial_bold"
            android:paddingHorizontal="17dp"
            android:paddingVertical="3dp"
            android:text="Aktif"
            android:textColor="@color/sky_blue"
            android:textSize="10sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="1.5dp"
            android:clipToOutline="false"/>
    </LinearLayout>

