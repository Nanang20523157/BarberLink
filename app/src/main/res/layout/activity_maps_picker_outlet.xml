<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:clipChildren="false"
    tools:context=".UserInterface.Admin.MapsPickerOutletActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#F8F6F6"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- Map View — must use <fragment> tag (not FragmentContainerView) for SupportMapFragment -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/mapFragmentContainer"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Center Pin with Shadow -->
        <LinearLayout
            android:id="@+id/centerPinContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="33dp"
                android:contentDescription="@string/icon_pin_center_desc"
                android:src="@drawable/ic_pin_center_figma" />

            <Space
                android:layout_width="8dp"
                android:layout_height="4dp" />

            <View
                android:layout_width="8dp"
                android:layout_height="4dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_pin_shadow_figma" />
        </LinearLayout>

        <!-- Top Navigation & Search -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="16dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Back Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <ImageView
                    android:id="@+id/ivBack"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/icon_back_button_desc"
                    android:src="@drawable/ic_back"
                    app:tint="#0F172A" />
            </androidx.cardview.widget.CardView>

            <!-- Search Bar -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvSearchBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:iconifiedByDefault="false"
                    app:queryBackground="@android:color/transparent"
                    app:queryHint="@string/search_hint_outlet" />
            </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Bottom Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="40dp"
            android:clipToPadding="false"
            app:layout_constraintBottom_toBottomOf="parent">

            <!-- Refresh Location Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnRefreshLocation"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <ImageView
                    android:layout_width="26.5dp"
                    android:layout_height="26.5dp"
                    android:layout_gravity="center"
                    android:layout_marginStart="0.25dp"
                    android:contentDescription="@string/address_refresh_desc"
                    android:src="@drawable/ic_refresh_location_figma"
                    app:tint="@color/sky_blue" />
            </androidx.cardview.widget.CardView>

            <!-- My Location Button -->
            <androidx.cardview.widget.CardView
                android:id="@+id/btnMyLocation"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/icon_my_location_desc"
                    android:src="@drawable/ic_my_location_figma" />
            </androidx.cardview.widget.CardView>

            <!-- Address Information Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cvAddressInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="12dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:clipToPadding="false">

                    <!-- Top Row: Icon + Texts -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- Cyan Map Pin Icon -->
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="36dp"
                            android:contentDescription="@string/icon_location_pin_teal_desc"
                            android:src="@drawable/ic_location_pin_teal_bg" />

                        <!-- Address Texts -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="16dp"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/selected_address_label"
                                android:textColor="#94a3b8"
                                android:textSize="13sp"
                                android:letterSpacing="0.05"
                                android:fontFamily="@font/public_sans_semibold" />

                            <TextView
                                android:id="@+id/tvSelectedAddress"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="---"
                                android:textColor="#0f172a"
                                android:textSize="16sp"
                                android:maxLines="2"
                                android:ellipsize="marquee"
                                android:textStyle="bold"
                                android:marqueeRepeatLimit="marquee_forever"/>

                            <!-- Coordinate Pills -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:layout_marginTop="10dp"
                                android:layout_marginStart="-1dp">

                                <TextView
                                    android:id="@+id/tvLatitude"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/bg_location_pill_figma"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:paddingTop="2dp"
                                    android:paddingBottom="2dp"
                                    android:text="@string/latitude_placeholder"
                                    android:textColor="#475569"
                                    android:textSize="12sp"
                                    android:typeface="monospace" />

                                <TextView
                                    android:id="@+id/tvLongitude"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="8dp"
                                    android:background="@drawable/bg_location_pill_figma"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:paddingTop="2dp"
                                    android:paddingBottom="2dp"
                                    android:text="@string/longitude_placeholder"
                                    android:textColor="#475569"
                                    android:textSize="12sp"
                                    android:typeface="monospace" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Primary Button -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/btnConfirmLocation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="2dp"
                        app:cardBackgroundColor="#1a1a1a">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            android:orientation="horizontal"
                            android:gravity="center">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="match_parent"
                                android:text="@string/confirm_location_text"
                                android:textColor="#80ba48"
                                android:textSize="16sp"
                                android:gravity="center"
                                android:layout_marginTop="-2dp"
                                android:fontFamily="@font/public_sans_bold" />

                            <ImageView
                                android:layout_width="19.5dp"
                                android:layout_height="19.5dp"
                                android:layout_marginStart="7dp"
                                android:contentDescription="@string/icon_check_mark_circle_desc"
                                android:src="@drawable/ic_check_mark_circle"
                                app:tint="@color/green_lime_wf"/>
                        </LinearLayout>
                    </androidx.cardview.widget.CardView>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
