<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingHorizontal="16dp"
    android:paddingBottom="3dp"
    android:clipToPadding="false"
    android:clipChildren="false">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cvMainInfoEmployee"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="1.5dp"
        app:cardBackgroundColor="@color/light_grey_horizons_background">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="7dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:orientation="vertical">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="20dp"
                app:cardElevation="0.5dp"
                android:backgroundTint="@color/light_grey_horizons_background">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="25dp"
                    android:clipToPadding="false"
                    android:clipChildren="false"
                    android:layout_gravity="center">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivPhotoProfile"
                        android:layout_width="55dp"
                        android:layout_height="55dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="13dp"
                        android:layout_marginEnd="16dp"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/user_profile_placeholder_desc"
                        android:src="@drawable/customer_profile_placeholder"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/tvEmployeeName"
                        app:layout_constraintHorizontal_bias="0.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_marginTop="-1dp"
                        android:layout_marginEnd="1dp"
                        android:src="@drawable/image_alert"
                        android:visibility="gone"
                        app:layout_constraintTop_toTopOf="@id/ivPhotoProfile"
                        app:layout_constraintEnd_toEndOf="@id/ivPhotoProfile"/>

                    <TextView
                        android:id="@+id/tvEmployeeName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        tools:text="Nanang Kurniawan"
                        android:textColor="@color/black_font_color"
                        android:ellipsize="end"
                        android:fontFamily="@font/arial_bold"
                        android:maxLines="1"
                        android:textSize="15.5sp"
                        android:layout_marginTop="-3.5dp"
                        android:textAppearance="@style/TextAppearance.AppCompat.Medium"
                        android:textStyle="bold"
                        android:layout_marginEnd="10dp"
                        app:layout_constraintTop_toTopOf="@id/llGender"
                        app:layout_constraintStart_toEndOf="@id/ivPhotoProfile"
                        app:layout_constraintEnd_toStartOf="@id/llGender" />

                    <TextView
                        android:id="@+id/tvUsername"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/username_template"
                        android:fontFamily="@font/arial_medium"
                        android:textSize="9.5sp"
                        android:layout_marginTop="-2dp"
                        android:layout_marginStart="0.5dp"
                        android:textColor="@color/platinum_grey_background"
                        app:layout_constraintStart_toStartOf="@id/tvEmployeeName"
                        app:layout_constraintTop_toBottomOf="@id/tvEmployeeName"/>

                    <LinearLayout
                        android:id="@+id/llRating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="7dp"
                        app:layout_constraintStart_toStartOf="@id/tvEmployeeName"
                        app:layout_constraintTop_toBottomOf="@id/tvUsername">

                        <ImageView
                            android:id="@+id/ivStarOne"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/full_star"
                            android:contentDescription="@string/star_image_desc"/>

                        <ImageView
                            android:id="@+id/ivStarTwo"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/full_star"
                            android:contentDescription="@string/star_image_desc"/>

                        <ImageView
                            android:id="@+id/ivStarThree"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/full_star"
                            android:contentDescription="@string/star_image_desc"/>

                        <ImageView
                            android:id="@+id/ivStarFour"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="4dp"
                            android:src="@drawable/full_star"
                            android:contentDescription="@string/star_image_desc"/>

                        <ImageView
                            android:id="@+id/ivStarFive"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:layout_marginEnd="6dp"
                            android:src="@drawable/full_star"
                            android:contentDescription="@string/star_image_desc"/>

                        <TextView
                            android:id="@+id/tvRating"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/five_star_rating"
                            android:textSize="11sp"
                            android:layout_marginTop="-1.8dp"
                            android:textAppearance="@style/TextAppearance.AppCompat.Small"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvReviewsAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/number_of_reviews_placeholder"
                        android:fontFamily="@font/arial_medium"
                        android:textSize="10.5sp"
                        android:layout_marginTop="2.5dp"
                        android:layout_marginStart="2dp"
                        android:textColor="@color/black_font_color"
                        android:textAppearance="@style/TextAppearance.AppCompat.Small"
                        app:layout_constraintStart_toStartOf="@id/tvEmployeeName"
                        app:layout_constraintTop_toBottomOf="@id/llRating"/>

                    <LinearLayout
                        android:id="@+id/llGender"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:paddingVertical="2dp"
                        android:gravity="center"
                        android:background="@drawable/gender_masculine_background"
                        android:paddingHorizontal="4dp"
                        android:layout_marginEnd="17dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/ivGender"
                            android:layout_width="12.5dp"
                            android:layout_height="12.5dp"
                            android:src="@drawable/ic_male"
                            android:contentDescription="@string/icon_gender_ilustration" />

                        <TextView
                            android:id="@+id/tvGender"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Laki-laki"
                            android:fontFamily="@font/arial_bold"
                            android:textColor="@color/black_font_color"
                            android:textSize="10sp"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="3dp"
                            android:gravity="center"
                            android:layout_gravity="center_vertical"/>

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvRole"
                        android:layout_width="110dp"
                        android:layout_height="30dp"
                        android:layout_gravity="bottom"
                        android:layout_marginEnd="17dp"
                        android:layout_marginTop="15dp"
                        android:gravity="center"
                        android:background="@drawable/role_background_employee"
                        android:fontFamily="@font/arial_bold"
                        android:textColor="@color/green_lime"
                        android:textSize="12sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/llGender"
                        app:layout_constraintVertical_bias="1"
                        tools:text=" Capster " />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:id="@+id/llSwitchActiveState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginEnd="11dp"
                android:layout_marginBottom="8dp"
                app:layout_constraintTop_toTopOf="@id/tvLabelKodeKasir"
                app:layout_constraintEnd_toEndOf="parent">

                <!--      android:text="Nonaktifkan Pegawai"      -->
                <TextView
                    android:id="@+id/tvOpenStateLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Kelola Tindakan"
                    android:textSize="14sp"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/platinum_grey_background"
                    android:layout_marginStart="30dp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_weight="1"/>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switch2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"
                    android:layout_marginEnd="3dp"
                    android:scaleX="0.45"
                    style="@style/Widget.App.Switch2"
                    android:visibility="gone"
                    android:scaleY="0.45" />

                <ImageButton
                    android:id="@+id/btnBlockUser"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:scaleX="1.34"
                    android:scaleY="1.34"
                    android:layout_marginEnd="3dp"
                    android:layout_marginTop="0.2dp"
                    android:src="@drawable/ic_block_user"
                    android:layout_gravity="center"
                    android:background="@android:color/transparent"/>

                <ImageButton
                    android:id="@+id/btnFlagReport"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:scaleX="1.23"
                    android:scaleY="1.23"
                    android:layout_marginEnd="4dp"
                    android:src="@drawable/ic_report_flag"
                    android:layout_gravity="center"
                    android:layout_marginTop="-0.5dp"
                    android:background="@android:color/transparent"/>

                <ImageButton
                    android:id="@+id/btnWarningLetter"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:scaleX="1.3"
                    android:scaleY="1.3"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_warning_letter"
                    android:layout_gravity="center"
                    android:layout_marginTop="-0.9dp"
                    android:background="@android:color/transparent"/>

            </LinearLayout>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</FrameLayout>
